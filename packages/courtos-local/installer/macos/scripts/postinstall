#!/bin/sh
# CourtOS starts at every login (LaunchAgent). Start it now for the user at the screen,
# and open the browser once.
agent=/Library/LaunchAgents/ch.courtos.local.plist
chown root:wheel "$agent"
chmod 644 "$agent"
user=$(stat -f%Su /dev/console)
[ -n "$user" ] && [ "$user" != root ] && [ "$user" != _mbsetupuser ] || exit 0
uid=$(id -u "$user")
launchctl bootout "gui/$uid" "$agent" 2>/dev/null || true
launchctl bootstrap "gui/$uid" "$agent" 2>/dev/null || true
sleep 2
launchctl asuser "$uid" sudo -u "$user" /usr/bin/open -a /Applications/CourtOS.app 2>/dev/null || true
exit 0
