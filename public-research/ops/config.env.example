# Existing public SQLite file, readable but never writable by courtos-research.
# Local mode only. Switchboard uses PUBLIC_RESEARCH_MODE=opencaselaw and no corpus.
PUBLIC_RESEARCH_MODE=local
# Use the physical public-data path, not a path below the inaccessible /opt/caselaw.
PUBLIC_RESEARCH_DB=/srv/courtos-public-data/decisions.db
PUBLIC_RESEARCH_TIMEOUT_MS=1500
PUBLIC_RESEARCH_CONCURRENCY=2
